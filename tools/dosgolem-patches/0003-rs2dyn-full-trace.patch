diff --git a/cmd/rs2dyn/trace_full.go b/cmd/rs2dyn/trace_full.go
new file mode 100644
index 0000000..123f9cd
--- /dev/null
+++ b/cmd/rs2dyn/trace_full.go
@@ -0,0 +1,342 @@
+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+)
+
+// 逐幀完整狀態收據（JSON Lines）。格式與取樣點定義見 docs/re/10-dynamic-receipts.md「逐幀收據」。
+//
+// 取樣在「某個固定位址的指令剛執行完」的那一刻進行（m.Insn() 是剛執行完的指令）。
+// 每個邏輯幀恰好走過其中一個取樣點一次：
+//
+//	第一關 sub_10F41 結尾 10F98h（mov cx, 2，緊接 call sub_11097）；頭目段 sub_10F9F 的 10FE3h。
+//	  sub_10EEA 每次呼叫恰好走進這兩個函式之一。幀計數的 inc 在取樣點之前，取樣值是遞增後的值。
+//	第二至四關每個幀函式把 inc word_1CFE2 放在 call sub_11097 之後，取樣點取 inc 剛執行完：
+//	  1333Ch／13390h（sub_132EB／sub_13344）、13B5Fh／13BBBh（sub_13B0A／sub_13B75）、
+//	  13EF4h／13F42h（sub_13EAB／sub_13EF9）。取樣值同樣是遞增後的值。
+//
+// 位址是 IDA 線性位址，執行期換算用 rt.base（INT 8 向量定出的映像基底）。
+const dsBias = 0x1CBC0 // dseg:0 的 IDA 線性位址
+
+var (
+	sigMovCx2 = []byte{0xB9, 0x02, 0x00, 0xE8} // mov cx, 2 ; call sub_11097
+	sigIncFr  = []byte{0xFF, 0x06, 0x22, 0x04} // inc word ptr ds:422h（word_1CFE2）
+)
+
+// tracePoint 是一個取樣或計數位址。sample 為真時取樣；inc 為真時計入幀計數遞增次數。
+type tracePoint struct {
+	ida    uint32
+	sample bool
+	inc    bool
+	sig    []byte
+}
+
+var tracePoints = []tracePoint{
+	{0x10F98, true, false, sigMovCx2}, {0x10FE3, true, false, sigMovCx2},
+	{0x10F6E, false, true, sigIncFr}, {0x10FD3, false, true, sigIncFr},
+	{0x1333C, true, true, sigIncFr}, {0x13390, true, true, sigIncFr},
+	{0x13B5F, true, true, sigIncFr}, {0x13BBB, true, true, sigIncFr},
+	{0x13EF4, true, true, sigIncFr}, {0x13F42, true, true, sigIncFr},
+}
+
+const (
+	ptLo = 0x10F6E
+	ptHi = 0x13F42
+)
+
+// fullTracer 是 trace NAME full 的狀態。
+type fullTracer struct {
+	f    *os.File
+	w    *bufio.Writer
+	n    uint64  // 已寫出的筆數
+	incs uint64  // 追蹤開始後執行過的 inc word_1CFE2 次數（各處合計）
+	tbl  []uint8 // 索引 = IDA 位址 − ptLo；0 無、1 取樣、2 計數、3 兩者
+	lo   uint32  // ptLo 的執行期線性位址
+	buf  []byte
+}
+
+func (r *rt) traceFullStart(name string) error {
+	if _, err := r.gaddr(idaBase); err != nil {
+		return err
+	}
+	for _, p := range tracePoints {
+		a := r.base + p.ida - idaBase
+		for i, b := range p.sig {
+			if got := r.m.Read8(a + uint32(i)); got != b {
+				return fmt.Errorf("取樣點 %05X 的機器碼不符（第 %d 位元組 %02X，預期 %02X），拒絕追蹤", p.ida, i, got, b)
+			}
+		}
+	}
+	f, err := os.Create(filepath.Join(r.out, "trace-"+name+".jsonl"))
+	if err != nil {
+		return err
+	}
+	t := &fullTracer{f: f, w: bufio.NewWriterSize(f, 1<<20), buf: make([]byte, 0, 16384),
+		tbl: make([]uint8, ptHi-ptLo+1), lo: r.base + ptLo - idaBase}
+	for _, p := range tracePoints {
+		var v uint8
+		if p.sample {
+			v |= 1
+		}
+		if p.inc {
+			v |= 2
+		}
+		t.tbl[p.ida-ptLo] = v
+	}
+	r.keyLog = r.keyLog[:0]
+	r.tf = t
+	r.logf("trace", "start %s full (JSONL) base=%05X points=%d", name, r.base, len(tracePoints))
+	return nil
+}
+
+func (r *rt) traceFullStop() {
+	t := r.tf
+	if t == nil {
+		return
+	}
+	t.w.Flush()
+	t.f.Close()
+	r.logf("trace", "stop full rows=%d incs=%d", t.n, t.incs)
+	r.tf = nil
+}
+
+// traceFullTick 在每道指令之後呼叫。m.Insn() 是剛執行完的那道指令的位址；
+// 中斷處理常式的指令位址不同，所以中斷插入不會造成重複或漏取。
+func (r *rt) traceFullTick() {
+	t := r.tf
+	cs, ip := r.m.Insn()
+	lin := uint32(cs)<<4 + uint32(ip)
+	if lin < t.lo || lin-t.lo >= uint32(len(t.tbl)) {
+		return
+	}
+	v := t.tbl[lin-t.lo]
+	if v == 0 {
+		return
+	}
+	if v&2 != 0 {
+		t.incs++
+	}
+	if v&1 != 0 {
+		r.sampleFull(lin - r.base + idaBase)
+	}
+}
+
+func (r *rt) dsw(off uint32) uint16 { return r.m.Read16(r.base + dsBias - idaBase + off) }
+
+// 以 IDA 線性位址讀（word_1CFE2 之類的名稱用）。
+func (r *rt) iw(ida uint32) uint16 { return r.m.Read16(r.base + ida - idaBase) }
+func (r *rt) ib(ida uint32) uint8  { return r.m.Read8(r.base + ida - idaBase) }
+
+func putKV(b []byte, k string, v uint32) []byte {
+	b = append(b, '"')
+	b = append(b, k...)
+	b = append(b, '"', ':')
+	return strconv.AppendUint(b, uint64(v), 10)
+}
+
+func (r *rt) wordArr(b []byte, ida uint32, n int) []byte {
+	b = append(b, '[')
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = strconv.AppendUint(b, uint64(r.iw(ida+uint32(i)*2)), 10)
+	}
+	return append(b, ']')
+}
+
+// player 一位玩家的欄位：每個值是 IDA 位址與寬度，位址由 docs/re/11 第 9.2 節列出並以機器碼核對。
+type playerFld struct {
+	key  string
+	ida  uint32
+	word bool
+}
+
+var player1 = []playerFld{
+	{"col", 0x1DACB, true}, {"row", 0x1DAC9, true}, {"x", 0x1DAC7, true}, {"y", 0x1DAC5, true},
+	{"img", 0x1DABD, true}, {"hit", 0x1DAC0, false}, {"inv", 0x1DAC1, false}, {"die", 0x1DAC3, false},
+	{"hp", 0x1CFDE, true}, {"wpn", 0x1DAA9, true}, {"pod1", 0x1DA8D, false}, {"pod2", 0x1DA8E, false},
+	{"face", 0x1DA8F, true}, {"chg", 0x1DA8B, true},
+}
+
+var player2 = []playerFld{
+	{"col", 0x1DB39, true}, {"row", 0x1DB37, true}, {"x", 0x1DB21, true}, {"y", 0x1DB1F, true},
+	{"img", 0x1DB17, true}, {"hit", 0x1DB1A, false}, {"inv", 0x1DB1B, false}, {"die", 0x1DB1D, false},
+	{"hp", 0x1CFE0, true}, {"wpn", 0x1DB0B, true}, {"pod1", 0x1DAEF, false}, {"pod2", 0x1DAF0, false},
+	{"face", 0x1DAF1, true}, {"chg", 0x1DAED, true},
+}
+
+func (r *rt) playerObj(b []byte, fl []playerFld) []byte {
+	b = append(b, '{')
+	for i, f := range fl {
+		if i > 0 {
+			b = append(b, ',')
+		}
+		if f.word {
+			b = putKV(b, f.key, uint32(r.iw(f.ida)))
+		} else {
+			b = putKV(b, f.key, uint32(r.ib(f.ida)))
+		}
+	}
+	return append(b, '}')
+}
+
+// pool 輸出指標表與每個非 0 指標指向的記錄原始字組。指標是 dseg 位移。
+func (r *rt) pool(b []byte, tkey, rkey string, tblOff uint32, slots, words int) []byte {
+	b = append(b, '"')
+	b = append(b, tkey...)
+	b = append(b, '"', ':', '[')
+	ptrs := make([]uint16, slots)
+	for i := 0; i < slots; i++ {
+		ptrs[i] = r.dsw(tblOff + uint32(i)*2)
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = strconv.AppendUint(b, uint64(ptrs[i]), 10)
+	}
+	b = append(b, ']', ',', '"')
+	b = append(b, rkey...)
+	b = append(b, '"', ':', '[')
+	first := true
+	for i, p := range ptrs {
+		if p == 0 {
+			continue
+		}
+		if !first {
+			b = append(b, ',')
+		}
+		first = false
+		b = append(b, '{')
+		b = putKV(b, "s", uint32(i))
+		b = append(b, ',', '"', 'w', '"', ':', '[')
+		for k := 0; k < words; k++ {
+			if k > 0 {
+				b = append(b, ',')
+			}
+			b = strconv.AppendUint(b, uint64(r.dsw(uint32(p)+uint32(k)*2)), 10)
+		}
+		b = append(b, ']', '}')
+	}
+	return append(b, ']')
+}
+
+func (r *rt) dsArr(b []byte, key string, off uint32, n int) []byte {
+	b = append(b, '"')
+	b = append(b, key...)
+	b = append(b, '"', ':', '[')
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = strconv.AppendUint(b, uint64(r.dsw(off+uint32(i)*2)), 10)
+	}
+	return append(b, ']')
+}
+
+func (r *rt) sampleFull(pt uint32) {
+	t := r.tf
+	m := r.m
+	b := t.buf[:0]
+	b = append(b, '{')
+	b = putKV(b, "n", uint32(t.n))
+	b = append(b, ',')
+	b = putKV(b, "frame", uint32(r.iw(0x1CFE2)))
+	b = append(b, `,"pt":"`...)
+	b = strconv.AppendUint(b, uint64(pt), 16)
+	b = append(b, `",`...)
+	b = putKV(b, "page", uint32(r.iw(0x26872)))
+	b = append(b, ',')
+	b = putKV(b, "in1", uint32(r.ib(0x1DAA4)))
+	b = append(b, ',')
+	b = putKV(b, "in2", uint32(r.ib(0x1DB06)))
+	b = append(b, ',')
+	b = append(b, `"sc":[`...)
+	for i, k := range r.keyLog {
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = strconv.AppendUint(b, uint64(k), 10)
+	}
+	r.keyLog = r.keyLog[:0]
+	b = append(b, `],`...)
+	b = putKV(b, "alive", uint32(r.ib(0x1CFDD)))
+	b = append(b, ',')
+	b = putKV(b, "clear", uint32(r.ib(0x1CFAD)))
+	b = append(b, ',', '"', 'p', '1', '"', ':')
+	b = r.playerObj(b, player1)
+	b = append(b, ',', '"', 'p', '2', '"', ':')
+	b = r.playerObj(b, player2)
+	b = append(b, ',', '"', 'b', 'g', '"', ':')
+	b = append(b, '[')
+	for i, a := range []uint32{0x1E6B8, 0x1E6BA, 0x1E6BC, 0x1E6BE} {
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = strconv.AppendUint(b, uint64(r.iw(a)), 10)
+	}
+	b = append(b, ']', ',')
+	b = r.pool(b, "ent_t", "ent", 0x2294, 15, 24)
+	b = append(b, ',')
+	b = r.pool(b, "pb_t", "pb", 0x2607, 20, 16)
+	b = append(b, ',')
+	b = r.pool(b, "eb_t", "eb", 0x32B3, 20, 15)
+	b = append(b, ',')
+	b = r.dsArr(b, "fx_x", 0x3FC2, 30)
+	b = append(b, ',')
+	b = r.dsArr(b, "fx_y", 0x3FFE, 30)
+	b = append(b, ',')
+	b = r.dsArr(b, "fx_a", 0x403A, 30)
+	b = append(b, ',')
+	b = r.dsArr(b, "g_st", 0x19C8, 10)
+	b = append(b, ',')
+	b = r.dsArr(b, "g_x", 0x19A0, 10)
+	b = append(b, ',')
+	b = r.dsArr(b, "g_y", 0x19B4, 10)
+	b = append(b, ',')
+	b = r.dsArr(b, "g_dx", 0x198C, 10)
+	b = append(b, ',', '"', 'm', 'i', 's', 'c', '"', ':', '{')
+	b = putKV(b, "seek", uint32(r.iw(0x1F1A8)))
+	b = append(b, ',')
+	b = putKV(b, "dhp", uint32(r.iw(0x1E6B2)))
+	b = append(b, ',')
+	b = putKV(b, "dfire", uint32(r.iw(0x1E6B4)))
+	b = append(b, ',')
+	b = putKV(b, "boom", uint32(r.ib(0x1CFAE)))
+	b = append(b, ',')
+	b = putKV(b, "demo", uint32(r.ib(0x1CFDC)))
+	b = append(b, ',')
+	b = putKV(b, "stage", uint32(r.ib(0x1CFDB)))
+	b = append(b, ',')
+	b = putKV(b, "nodmg", uint32(r.iw(0x273A5)))
+	b = append(b, ',')
+	b = putKV(b, "fx0", uint32(r.iw(0x20B7A)))
+	b = append(b, ',')
+	b = putKV(b, "fx1", uint32(r.iw(0x20B7C)))
+	b = append(b, ',')
+	b = putKV(b, "fx2", uint32(r.iw(0x20B7E)))
+	b = append(b, '}', ',', '"', 'e', 'm', 'u', '"', ':', '{')
+	b = append(b, '"', 's', 't', 'e', 'p', '"', ':')
+	b = strconv.AppendUint(b, m.Steps, 10)
+	b = append(b, ',')
+	b = append(b, '"', 't', 'i', 'c', 'k', 's', '"', ':')
+	b = strconv.AppendUint(b, m.Ticks, 10)
+	b = append(b, ',')
+	b = append(b, '"', 'i', 'n', 'c', 's', '"', ':')
+	b = strconv.AppendUint(b, t.incs, 10)
+	b = append(b, '}', '}', '\n')
+	t.w.Write(b)
+	t.buf = b
+	t.n++
+}
+
+// untilTraceRows 跑到完整追蹤已寫出 n 筆。
+func (r *rt) untilTraceRows(n, budget uint64) error {
+	if r.tf == nil {
+		return fmt.Errorf("完整追蹤還沒開（trace NAME full）")
+	}
+	return r.runUntil(fmt.Sprintf("追蹤筆數 >= %d", n), func() bool { return r.tf.n >= n }, budget)
+}
