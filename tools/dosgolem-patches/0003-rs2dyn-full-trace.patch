-			r.logf("trapped", "%s #%d AX=%04X BX=%04X CX=%04X DX=%04X ES=%04X DI=%04X DS=%04X SI=%04X", t.name, t.n,
+			fr := ""
+			if strings.HasPrefix(t.name, "ida") {
+				v, _ := r.rd16(idaFrame)
+				fr = fmt.Sprintf(" frame=%d", v)
+			}
+			r.logf("trapped", "%s #%d%s AX=%04X BX=%04X CX=%04X DX=%04X ES=%04X DI=%04X DS=%04X SI=%04X", t.name, t.n, fr,
 				c.R[cpu.AX], c.R[cpu.BX], c.R[cpu.CX], c.R[cpu.DX], c.Seg[cpu.ES], c.R[cpu.DI], c.Seg[cpu.DS], c.R[cpu.SI])
 		}
 	}
