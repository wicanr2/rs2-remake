+package main
+
+import (
+	"fmt"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// tracepc IDA [max]：執行到這個 IDA 位址就記一行暫存器與目前幀計數（最多 max 次，預設 50）。
+func (r *rt) tracePC(ida uint32, max int) error {
+	la, err := r.gaddr(ida)
+	if err != nil {
+		return err
+	}
+	if r.traps == nil {
+		r.traps = map[uint32]*trapInfo{}
+	}
+	r.traps[la] = &trapInfo{name: fmt.Sprintf("ida%05X", ida), max: max}
+	r.logf("trap", "%s lin=%05X max=%d", r.traps[la].name, la, max)
+	return nil
+}
+
+// watchw NAME IDA LEN [max]：寫入 [IDA, IDA+LEN) 時記一行：寫入位址、舊新值、寫入者的 IDA 指令位址、幀計數。
+func (r *rt) watchWrite(name string, ida, n uint32, max int) error {
+	la, err := r.gaddr(ida)
+	if err != nil {
+		return err
+	}
+	cnt := 0
+	r.m.WatchWrite(la, la+n-1, func(m *machine.Machine, a uint32, old, nw uint8) {
+		if old == nw || cnt >= max {
+			return
+		}
+		cnt++
+		cs, ip := m.Insn()
+		wl := uint32(cs)<<4 + uint32(ip)
+		fr, _ := r.rd16(idaFrame)
+		r.logf("watchw", "%s write ida=%05X %02X->%02X by ida=%05X frame=%d AX=%04X BX=%04X SI=%04X DI=%04X DS=%04X", name,
+			a-r.base+idaBase, old, nw, wl-r.base+idaBase, fr,
+			m.CPU.R[cpu.AX], m.CPU.R[cpu.BX], m.CPU.R[cpu.SI], m.CPU.R[cpu.DI], m.CPU.Seg[cpu.DS])
+	})
+	r.logf("watchw", "%s armed ida=%05X len=%d lin=%05X max=%d", name, ida, n, la, max)
+	return nil
+}
