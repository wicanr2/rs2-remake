index 0000000..68816ee
--- /dev/null
+++ b/cmd/rs2dyn/play.go
@@ -0,0 +1,119 @@
+package main
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// play F0 TOKEN...：依逐幀輸入位元組送鍵。位元定義與 DMn.LCK、trace 的 in1 相同：
+//
+//	01 上  02 下  04 右  08 左  10 開火（右 Shift 按下再放開一次）  20 轉向（/ 鍵按下再放開一次）
+//
+// 第 i 個位元組是第 F0+i 筆追蹤（n = F0+i）那一幀要讀到的輸入：在 n = F0+i−1 的取樣之後立刻送鍵，
+// 所以需要完整追蹤已開（trace NAME full）。TOKEN 是兩位十六進位，或 HH*N 表示重複 N 次。
+// TOKEN 也可以是 @NAME：在該位置（上一幀的取樣寫出之後、下一個位元組的鍵送出之前）存畫面 NAME.png。
+// 方向鍵是持續按住，只在位元改變時送按下／放開；開火與轉向每幀按放一次。
+// 結束時放開仍按住的方向鍵。送鍵的時刻只由追蹤筆數決定，與牆鐘無關，所以可重播。
+func (r *rt) play(f0 uint64, toks []string) error {
+	if r.tf == nil {
+		return fmt.Errorf("play 需要完整追蹤（trace NAME full）")
+	}
+	var seq []byte
+	marks := map[int][]string{}
+	for _, t := range toks {
+		if strings.HasPrefix(t, "@") {
+			marks[len(seq)] = append(marks[len(seq)], t[1:])
+			continue
+		}
+		n := uint64(1)
+		if i := strings.IndexByte(t, '*'); i >= 0 {
+			v, err := strconv.ParseUint(t[i+1:], 10, 32)
+			if err != nil {
+				return fmt.Errorf("重複次數 %q：%w", t, err)
+			}
+			n, t = v, t[:i]
+		}
+		b, err := strconv.ParseUint(t, 16, 8)
+		if err != nil {
+			return fmt.Errorf("輸入位元組 %q：%w", t, err)
+		}
+		for ; n > 0; n-- {
+			seq = append(seq, byte(b))
+		}
+	}
+	dirs := [4]struct {
+		bit  byte
+		name string
+	}{{0x01, "up"}, {0x02, "down"}, {0x04, "right"}, {0x08, "left"}}
+	gap := func() error { return r.runTo(r.m.Steps + r.m.KeyEvery + 1) }
+	tap := func(name string) error {
+		sc, _ := keyScan(name)
+		r.down(sc)
+		if err := gap(); err != nil {
+			return err
+		}
+		r.up(sc)
+		return gap()
+	}
+	var held byte
+	for i, b := range seq {
+		target := f0 + uint64(i)
+		if r.tf.n > target {
+			return fmt.Errorf("play 位元組 %d 要送給 n=%d，但追蹤已寫到 %d 筆", i, target, r.tf.n)
+		}
+		if err := r.untilTraceRows(target, 1_500_000_000); err != nil {
+			return err
+		}
+		for _, nm := range marks[i] {
+			if err := r.shot(nm); err != nil {
+				return err
+			}
+		}
+		for _, d := range dirs {
+			want, had := b&d.bit != 0, held&d.bit != 0
+			if want == had {
+				continue
+			}
+			sc, _ := keyScan(d.name)
+			if want {
+				r.down(sc)
+			} else {
+				r.up(sc)
+			}
+			if err := gap(); err != nil {
+				return err
+			}
+		}
+		held = b & 0x0F
+		if b&0x10 != 0 {
+			if err := tap("rshift"); err != nil {
+				return err
+			}
+		}
+		if b&0x20 != 0 {
+			if err := tap("/"); err != nil {
+				return err
+			}
+		}
+	}
+	if err := r.untilTraceRows(f0+uint64(len(seq)), 1_500_000_000); err != nil {
+		return err
+	}
+	for _, nm := range marks[len(seq)] {
+		if err := r.shot(nm); err != nil {
+			return err
+		}
+	}
+	for _, d := range dirs {
+		if held&d.bit != 0 {
+			sc, _ := keyScan(d.name)
+			r.up(sc)
+			if err := gap(); err != nil {
+				return err
+			}
+		}
+	}
+	r.logf("play", "f0=%d frames=%d", f0, len(seq))
+	return nil
+}
