diff --git a/cmd/rs2dyn/audio.go b/cmd/rs2dyn/audio.go
new file mode 100644
index 00000000..06c291d9
--- /dev/null
+++ b/cmd/rs2dyn/audio.go
@@ -0,0 +1,61 @@
+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// audioTrace 記下 OPL 暫存器寫入、喇叭閘門與 PIT 通道 2 的變化，一行一筆：
+//
+//	種類 步數 tick 週期（只有 OPL 有） 值...
+//
+// tick 是 IRQ 0 的累計次數，ASMDRV 改寫 PIT 之後就是驅動的計時 tick。
+type audioTrace struct {
+	f *os.File
+	w *bufio.Writer
+}
+
+func (r *rt) audioStart(name string) error {
+	if r.au != nil {
+		return fmt.Errorf("audiotrace 已經開著")
+	}
+	f, err := os.Create(filepath.Join(r.out, "audio-"+name+".tsv"))
+	if err != nil {
+		return err
+	}
+	a := &audioTrace{f: f, w: bufio.NewWriter(f)}
+	r.au = a
+	m := r.m
+	m.ObserveOPLWrites(func(w machine.OPLWrite) {
+		fmt.Fprintf(a.w, "O\t%d\t%d\t%d\t%02X\t%02X\n", w.Step, m.Ticks, w.Cycles, w.Reg, w.Val)
+	})
+	m.ObserveSpeaker(func(s machine.SpeakerSample) {
+		fmt.Fprintf(a.w, "S\t%d\t%d\t0\t%d\t%d\n", s.Step, m.Ticks, s.Level, s.Gate)
+	})
+	m.ObservePITChannel2(func(p machine.PIT2Change) {
+		fmt.Fprintf(a.w, "P\t%d\t%d\t0\t%d\t%d\n", p.Step, m.Ticks, p.Divisor, p.Mode)
+	})
+	r.logf("audiotrace", "start %s", name)
+	return nil
+}
+
+func (r *rt) audioStop() error {
+	if r.au == nil {
+		return fmt.Errorf("audiotrace 沒有開")
+	}
+	m := r.m
+	m.ObserveOPLWrites(nil)
+	m.ObserveSpeaker(nil)
+	m.ObservePITChannel2(nil)
+	err := r.au.w.Flush()
+	if e := r.au.f.Close(); err == nil {
+		err = e
+	}
+	r.au = nil
+	r.logf("audiotrace", "stop")
+	return err
+}
