+
+// dumpBanks 把圖庫記憶體存成 NAME.bk：10 位元組表頭是遮罩段與四個平面段（dseg:39Ch 起的 5 個段值），
+// 之後是第一段開頭到最後一段結尾（段起點 + 64 KB）的線性記憶體。越界圖號會讀到段內的殘留內容，
+// 要有這份才能在重製端重現並證實。
+func (r *rt) dumpBanks(name string) error {
+	if _, err := r.gaddr(0x1CBC0); err != nil {
+		return err
+	}
+	ds := r.base + dsBias - idaBase
+	var segs [5]uint32
+	b := make([]byte, 0, 10)
+	for i := range segs {
+		lo, hi := r.m.Read8(ds+0x39C+2*uint32(i)), r.m.Read8(ds+0x39D+2*uint32(i))
+		segs[i] = uint32(lo) | uint32(hi)<<8
+		b = append(b, lo, hi)
+	}
+	for a := segs[0] << 4; a < segs[4]<<4+0x10000; a++ {
+		b = append(b, r.m.Read8(a))
+	}
+	if err := os.WriteFile(filepath.Join(r.out, name+".bk"), b, 0o644); err != nil {
+		return err
+	}
+	r.logf("dumpbanks", "%s", name)
+	return nil
+}
