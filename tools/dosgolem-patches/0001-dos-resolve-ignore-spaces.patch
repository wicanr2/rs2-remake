+package dos
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// DOS 的路徑正規化略過名字裡的空白（DOSBox-X `DOS_MakeName`，dos_files.cpp）。
+// RS-2 的 `MY.GO ` 就是這樣：第 3 個副檔名位置留給單色模式改寫成 B，彩色模式不改寫，
+// 尾端空白要被 DOS 吃掉才開得到 MY.GO。沒有這條時遊戲在 sub_1C82C 無限重試。
+func TestResolveIgnoresSpaces(t *testing.T) {
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "MY.GO"), []byte("x"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	d := New(machine.New(), root)
+	for _, name := range []string{"MY.GO ", "MY.GO", "my.go ", " MY .GO"} {
+		if got := d.resolve(name); got == "" {
+			t.Errorf("resolve(%q) 找不到 MY.GO", name)
+		}
+	}
+	if got := d.resolve("MY.GOB"); got != "" {
+		t.Errorf("resolve(MY.GOB) = %q，不該存在", got)
+	}
+}
