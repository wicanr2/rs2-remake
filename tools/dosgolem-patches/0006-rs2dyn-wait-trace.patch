index 0000000..7edfd11
--- /dev/null
+++ b/cmd/rs2dyn/wait.go
@@ -0,0 +1,402 @@
+package main
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+// 全流程對拍的等待點收據（docs/spec/002-full-game.md「全流程對拍」）。
+//
+// waittrace NAME 在 sub_11097 離開等待的位置（IDA 1109Dh，jb 沒有跳回之後、mov word ptr ds:0A7F9h, 0 之前）記一筆。
+// 每個邏輯幀、每段動畫、每次等待都走這一點，所以涵蓋標題、過場與各關。輸出（皆在 -out 目錄）：
+//
+//	wait-NAME.jsonl  每筆 {"n","ret","cx","frame","sc","vram","dac","start"}
+//	  ret    堆疊上的返回位址換成 IDA 線性位址，十六進位小寫、不補零
+//	  cx     CX，也就是 sub_11097 的等待 tick 數
+//	  frame  word_1CFE2 幀計數
+//	  sc     上一筆之後「送達 INT 9」的掃描碼（放開碼帶 80h），以 IRQ1 送出的那一步為準，不是排程的那一刻
+//	  sct    sc 每個鍵送達時距上一筆已經過幾個 INT 8（IRQ0）。輪詢迴圈（沒有 sub_11097 的等待，例如片尾等按鍵、選單）
+//	         裡的鍵靠它排進對的 tick；等待裡的鍵不需要。選用欄位，規格 002 的欄位表沒有
+//	  vram   平面 0、1、2、3 各 64 KB 依序串接（共 256 KB）的 SHA-256
+//	  dac    256 色 DAC（768 位元組）串接屬性暫存器 0 至 15 與 overscan（17 位元組，同 shot 的 ac 欄）的 SHA-256
+//	  start  CRTC 顯示起點（m.DisplayStart）
+//	wait-NAME.dsd    資料段差異，小端序。第 0 筆存整個 64 KB（兩段各 32 KB，因為長度欄只有 16 位元），
+//	                 之後每筆只存和上一筆不同的位元組。每筆：u32 筆序、u32 段數，每段 u16 偏移、u16 長度、位元組。
+//	                 相隔 4 位元組以內的差異合成一段（多存的是未變的位元組）
+//	wait-NAME.pokes  waittrace 開著時的 poke、pokew，每行 `n 0x線性位址 寬 0x值`：n 是 poke 當時已寫出的筆數，
+//	                 也就是第 n 筆（0 起算）等待結束之前寫入，格式同 tools/dos/fuzz/*.pokes
+//
+// waittrace 只讀狀態（記憶體、平面、DAC、CPU 暫存器），不改變執行，同一份腳本不開它得到相同的步數。
+// 例外是 waitsync（預設開）：waittrace 開著時，下 down、up、poke、pokew 之前先跑到 sub_11097 的等待迴圈裡才動手，
+// 讓鍵與 poke 落在等待裡，和重製「恢復時處理掃描碼」的模型一致（docs/spec/002-full-game.md「全流程對拍」）。waittrace 沒開時完全不啟動。
+//
+// 位址簽章不符就拒絕開始。
+
+const (
+	idaWaitCmp = 0x11097 // cmp ds:0A7F9h, cx
+	idaWaitJb  = 0x1109B // jb short sub_11097
+	idaWaitOut = 0x1109D // mov word ptr ds:0A7F9h, 0
+)
+
+// sub_11097 整個函式的機器碼：cmp ds:0A7F9h, cx；jb；mov word ptr ds:0A7F9h, 0；retn。
+var sigWait = []byte{0x39, 0x0E, 0xF9, 0xA7, 0x72, 0xFA, 0xC7, 0x06, 0xF9, 0xA7, 0x00, 0x00, 0xC3}
+
+// errWaitStop 是 waitstop 傾印完成後的結束訊號，main 當成正常結束。
+var errWaitStop = errors.New("waitstop：已傾印並停止")
+
+// idaWaitTick 是 word_273B9 在資料段的 IDA 位址，等待迴圈比較的對象。
+const idaWaitTick = 0x273B9
+
+type waitTracer struct {
+	name string
+	jf   *os.File
+	jw   *bufio.Writer
+	df   *os.File
+	dw   *bufio.Writer
+	pf   *os.File // 第一次 poke 才建立
+
+	n         uint64 // 已寫出的筆數
+	prev, cur []byte // 上一筆與這一筆的資料段（prev 為 nil 表示還沒有）
+	buf       []byte
+
+	cmpLin, jbLin, outLin uint32 // 執行期線性位址
+	pre                   uint32 // 下一步執行前的 CS:IP 線性位址
+	sc                    []uint8
+	sct                   []uint32 // sc 每個鍵送達時，距上一筆的 INT 8 數
+	tick0                 uint64   // 上一筆（或開始）時的 m.Ticks
+	pend                  []uint8  // 已排程、還沒送達的掃描碼，順序與送達相同
+	irqs                  uint64   // 已處理的 m.KeyIRQs
+
+	stopAt int64 // >= 0：寫完這一筆（n 欄）之後傾印並停止
+
+	sync        bool
+	keyIn       uint64 // 在等待迴圈裡送達的鍵
+	keyOut      uint64 // 在等待迴圈外送達的鍵（例如輪詢迴圈、一幀的計算中）
+	syncTimeout uint64 // waitsync 等不到等待而放棄的次數
+	pokes       int
+}
+
+func (r *rt) waitStart(name string, stopAt int64) error {
+	if r.wt != nil {
+		return fmt.Errorf("waittrace %s 還開著", r.wt.name)
+	}
+	if _, err := r.gaddr(idaBase); err != nil {
+		return err
+	}
+	a := r.base + idaWaitCmp - idaBase
+	for i, b := range sigWait {
+		if got := r.m.Read8(a + uint32(i)); got != b {
+			return fmt.Errorf("sub_11097 的機器碼不符（第 %d 位元組 %02X，預期 %02X），拒絕追蹤", i, got, b)
+		}
+	}
+	jf, err := os.Create(filepath.Join(r.out, "wait-"+name+".jsonl"))
+	if err != nil {
+		return err
+	}
+	df, err := os.Create(filepath.Join(r.out, "wait-"+name+".dsd"))
+	if err != nil {
+		jf.Close()
+		return err
+	}
+	t := &waitTracer{name: name, jf: jf, jw: bufio.NewWriterSize(jf, 1<<16), df: df, dw: bufio.NewWriterSize(df, 1<<20),
+		cur: make([]byte, 0x10000), buf: make([]byte, 0, 1024),
+		cmpLin: a, jbLin: r.base + idaWaitJb - idaBase, outLin: r.base + idaWaitOut - idaBase,
+		stopAt: stopAt, sync: true, irqs: r.m.KeyIRQs, tick0: r.m.Ticks}
+	if r.wtStopAt >= 0 && stopAt < 0 {
+		t.stopAt = r.wtStopAt
+	}
+	// 開始之前已排程、還沒送達的鍵：定時事件先送，再來硬體佇列（machine.keyTick 的順序）。
+	for _, k := range r.m.ScheduledKeys() {
+		t.pend = append(t.pend, k.Code())
+	}
+	t.pend = append(t.pend, r.m.KeyCodes()...)
+	c := r.m.CPU
+	t.pre = uint32(c.Seg[cpu.CS])<<4 + uint32(c.IP)
+	r.wt = t
+	r.logf("waittrace", "start %s base=%05X stop=%d pending_keys=%d", name, r.base, t.stopAt, len(t.pend))
+	return nil
+}
+
+func (r *rt) waitClose() {
+	t := r.wt
+	if t == nil {
+		return
+	}
+	t.jw.Flush()
+	t.dw.Flush()
+	t.jf.Close()
+	t.df.Close()
+	if t.pf != nil {
+		t.pf.Close()
+	}
+	r.logf("waittrace", "stop %s rows=%d keys_in_wait=%d keys_outside_wait=%d pend_left=%d sync_timeouts=%d pokes=%d",
+		t.name, t.n, t.keyIn, t.keyOut, len(t.pend), t.syncTimeout, t.pokes)
+	r.wt = nil
+}
+
+// readDS 讀整個 64 KB 資料段。
+func (r *rt) readDS(dst []byte) {
+	lin := r.base + dsBias - idaBase
+	if lin+0x10000 <= 0xA0000 && int(lin)+0x10000 <= len(r.m.Mem) {
+		copy(dst, r.m.Mem[lin:lin+0x10000])
+		return
+	}
+	for i := range dst {
+		dst[i] = r.m.Read8(lin + uint32(i))
+	}
+}
+
+// waitTick 在每道指令之後呼叫。
+func (r *rt) waitTick() error {
+	t := r.wt
+	m := r.m
+	if m.KeyIRQs != t.irqs {
+		for ; t.irqs < m.KeyIRQs; t.irqs++ {
+			code := uint8(0xFF)
+			if len(t.pend) > 0 {
+				code, t.pend = t.pend[0], t.pend[1:]
+			} else {
+				r.logf("waittrace", "error 送達的鍵沒有對應的排程紀錄（掃描碼記成 FF）")
+			}
+			t.sc = append(t.sc, code)
+			t.sct = append(t.sct, uint32(m.Ticks-t.tick0))
+			if t.pre == t.cmpLin || t.pre == t.jbLin {
+				t.keyIn++
+			} else {
+				t.keyOut++
+				if t.keyOut <= 40 {
+					r.logf("waittrace", "key %02X 送達時不在等待迴圈裡（被中斷的指令 lin=%05X ida=%05X）", code, t.pre, t.pre-r.base+idaBase)
+				}
+			}
+		}
+	}
+	cs, ip := m.Insn()
+	c := m.CPU
+	now := uint32(c.Seg[cpu.CS])<<4 + uint32(c.IP)
+	if uint32(cs)<<4+uint32(ip) == t.jbLin && now == t.outLin {
+		if err := r.waitRecord(); err != nil {
+			return err
+		}
+	}
+	t.pre = now
+	return nil
+}
+
+func (r *rt) waitRecord() error {
+	t := r.wt
+	m := r.m
+	c := m.CPU
+	sp := uint32(c.Seg[cpu.SS])<<4 + uint32(c.R[cpu.SP])
+	retLin := uint32(c.Seg[cpu.CS])<<4 + uint32(m.Read16(sp))
+	b := t.buf[:0]
+	b = append(b, `{"n":`...)
+	b = strconv.AppendUint(b, t.n, 10)
+	b = append(b, `,"ret":"`...)
+	b = strconv.AppendUint(b, uint64(retLin-r.base+idaBase), 16)
+	b = append(b, `","cx":`...)
+	b = strconv.AppendUint(b, uint64(c.R[cpu.CX]), 10)
+	b = append(b, `,"frame":`...)
+	b = strconv.AppendUint(b, uint64(r.iw(idaFrame)), 10)
+	b = append(b, `,"sc":[`...)
+	for i, k := range t.sc {
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = strconv.AppendUint(b, uint64(k), 10)
+	}
+	b = append(b, `],"sct":[`...)
+	for i, k := range t.sct {
+		if i > 0 {
+			b = append(b, ',')
+		}
+		b = strconv.AppendUint(b, uint64(k), 10)
+	}
+	t.sc, t.sct, t.tick0 = t.sc[:0], t.sct[:0], m.Ticks
+	h := sha256.New()
+	for p := 0; p < 4; p++ {
+		h.Write(m.EGAPlane(p))
+	}
+	b = append(b, `],"vram":"`...)
+	b = hex.AppendEncode(b, h.Sum(nil))
+	h.Reset()
+	h.Write(m.DAC[:])
+	var ac [17]byte
+	for i := 0; i < 16; i++ {
+		ac[i] = m.VGA.Pal(i)
+	}
+	ac[16] = m.VGA.Overscan()
+	h.Write(ac[:])
+	b = append(b, `","dac":"`...)
+	b = hex.AppendEncode(b, h.Sum(nil))
+	b = append(b, `","start":`...)
+	b = strconv.AppendUint(b, uint64(m.DisplayStart()), 10)
+	b = append(b, '}', '\n')
+	t.jw.Write(b)
+	t.buf = b
+
+	r.readDS(t.cur)
+	t.writeDSD()
+	if t.prev == nil {
+		t.prev = make([]byte, 0x10000)
+	}
+	t.prev, t.cur = t.cur, t.prev
+	// 每筆都 flush：容器逾時被殺時，已寫出的筆數不會留在緩衝區裡。
+	t.jw.Flush()
+	t.dw.Flush()
+	t.n++
+	if t.stopAt >= 0 && int64(t.n-1) == t.stopAt {
+		name := fmt.Sprintf("%s-w%d", t.name, t.stopAt)
+		if err := r.dumpDS(name); err != nil {
+			return err
+		}
+		if err := r.dumpPlanes(name); err != nil {
+			return err
+		}
+		if err := r.shot(name); err != nil {
+			return err
+		}
+		r.logf("waitstop", "n=%d 已傾印 %s", t.stopAt, name)
+		return errWaitStop
+	}
+	return nil
+}
+
+// writeDSD 寫 .dsd 的一筆。cur 是這一筆的資料段，t.prev 是上一筆（nil 表示第一筆）。
+func (t *waitTracer) writeDSD() {
+	var segs []byte
+	var count uint32
+	seg := func(off, n int) {
+		var h [4]byte
+		binary.LittleEndian.PutUint16(h[0:], uint16(off))
+		binary.LittleEndian.PutUint16(h[2:], uint16(n))
+		segs = append(segs, h[:]...)
+		segs = append(segs, t.cur[off:off+n]...)
+		count++
+	}
+	if t.prev == nil {
+		seg(0, 0x8000)
+		seg(0x8000, 0x8000)
+	} else {
+		prev, cur := t.prev, t.cur
+		const gap = 4 // 相隔不超過這麼多位元組的差異合成一段
+		for i := 0; i < 0x10000; {
+			if prev[i] == cur[i] {
+				i++
+				continue
+			}
+			lo, hi, quiet := i, i, 0
+			for j := i + 1; j < 0x10000 && quiet <= gap; j++ {
+				if prev[j] != cur[j] {
+					hi, quiet = j, 0
+				} else {
+					quiet++
+				}
+			}
+			for lo <= hi {
+				n := hi - lo + 1
+				if n > 0x8000 {
+					n = 0x8000
+				}
+				seg(lo, n)
+				lo += n
+			}
+			i = hi + 1
+		}
+	}
+	var h [8]byte
+	binary.LittleEndian.PutUint32(h[0:], uint32(t.n))
+	binary.LittleEndian.PutUint32(h[4:], count)
+	t.dw.Write(h[:])
+	t.dw.Write(segs)
+}
+
+// waitSync 讓機器停在 sub_11097 的等待迴圈裡（而且這次等待還沒滿，之後至少還有一個指令邊界）。
+// 找不到時（輪詢迴圈沒有呼叫 sub_11097）過了預算就放棄，記一次 sync_timeouts。錯誤放進 r.wtErr，由下一個 step 回傳。
+func (r *rt) waitSync() {
+	t := r.wt
+	if t == nil || !t.sync || r.wtErr != nil {
+		return
+	}
+	inWait := func() bool {
+		c := r.m.CPU
+		lin := uint32(c.Seg[cpu.CS])<<4 + uint32(c.IP)
+		return (lin == t.cmpLin || lin == t.jbLin) && r.m.Read16(r.base+idaWaitTick-idaBase) < c.R[cpu.CX]
+	}
+	if inWait() {
+		return
+	}
+	budget := r.m.IRQ0Every * 6
+	if budget < 2_000_000 {
+		budget = 2_000_000
+	}
+	end := r.m.Steps + budget
+	for r.m.Steps < end && !r.d.Exited {
+		if err := r.step(); err != nil {
+			r.wtErr = err
+			return
+		}
+		if inWait() {
+			return
+		}
+	}
+	t.syncTimeout++
+}
+
+// waitSyncErr 是給 poke 命令用的 waitSync：回傳同步過程遇到的錯誤。
+func (r *rt) waitSyncErr() error {
+	r.waitSync()
+	e := r.wtErr
+	r.wtErr = nil
+	return e
+}
+
+// waitLogPoke 記一次 poke。呼叫端先 waitSync 再寫入。
+func (r *rt) waitLogPoke(ida uint32, width int, val uint32) error {
+	t := r.wt
+	if t == nil {
+		return nil
+	}
+	if t.pf == nil {
+		f, err := os.Create(filepath.Join(r.out, "wait-"+t.name+".pokes"))
+		if err != nil {
+			return err
+		}
+		t.pf = f
+	}
+	t.pokes++
+	_, err := fmt.Fprintf(t.pf, "%d 0x%X %d 0x%X\n", t.n, ida, width, val)
+	return err
+}
+
+// fontDump 把 F000:FA6E 起 2048 位元組存成 biosfont.bin。第一關的幀計數（sub_18A61）用 BIOS 字型，
+// 重製要用同一份才能逐像素對拍；這份字型不是遊戲素材，只留本機。
+func (r *rt) fontDump() error {
+	const base = 0xFFA6E
+	b := make([]byte, 2048)
+	for i := range b {
+		b[i] = r.m.Read8(base + uint32(i))
+	}
+	sum := sha256.Sum256(b)
+	if err := os.WriteFile(filepath.Join(r.out, "biosfont.bin"), b, 0o644); err != nil {
+		return err
+	}
+	r.logf("fontdump", "biosfont.bin 2048 bytes sha256=%s", hex.EncodeToString(sum[:]))
+	return nil
+}
+
+// untilWait 跑到 waittrace 已寫出 n 筆。
+func (r *rt) untilWait(n, budget uint64) error {
+	if r.wt == nil {
+		return fmt.Errorf("waittrace 還沒開")
+	}
+	return r.runUntil(fmt.Sprintf("等待筆數 >= %d", n), func() bool { return r.wt.n >= n }, budget)
+}
