+// untilRowOrExit 跑到完整追蹤已寫出 n 筆，或主迴圈已離開（loopExit）。回傳 true 表示是因為離開而停，
+// 此時筆數不足 n，後面不會再有取樣。
+func (r *rt) untilRowOrExit(n, budget uint64) (bool, error) {
+	t := r.tf
+	if t == nil {
+		return false, fmt.Errorf("完整追蹤還沒開（trace NAME full）")
+	}
+	err := r.runUntil(fmt.Sprintf("追蹤筆數 >= %d 或主迴圈離開", n), func() bool { return t.n >= n || t.exited }, budget)
+	return err == nil && t.n < n && t.exited, err
+}
+
+// settle 讓最近一次取樣所在的那半步走完（到 10D32h 或 10D29h），或確認主迴圈已在這之前離開，
+// 然後寫 trace-NAME.end。收據的最後一筆因此帶著原版自己的結論：之後這個迴圈是否離開、離開碼是什麼。
+// 沒有它，play 一送完最後一筆就停在取樣點上，離開判斷（sub_10D8D 與 10D41h 起的比較）還沒執行。
+//
+// 檔案內容一行：rows=N exit=none，或 rows=N exit=E|Q|C。exit 以 10D59h 執行時的 DX 低位元組為準。
+func (r *rt) settle() error {
+	t := r.tf
+	if t == nil {
+		return fmt.Errorf("完整追蹤還沒開（trace NAME full）")
+	}
+	if t.n == 0 {
+		return fmt.Errorf("settle 需要至少一筆取樣")
+	}
+	if err := r.runUntil("取樣所在的半步走完", func() bool { return t.stepDone || t.exited }, 50_000_000); err != nil {
+		return err
+	}
+	code := "none"
+	if t.exited {
+		code = string(rune(byte(t.exitDX)))
+	}
+	line := fmt.Sprintf("rows=%d exit=%s\n", t.n, code)
+	r.logf("settle", "%s %s", t.name, line[:len(line)-1])
+	return os.WriteFile(filepath.Join(r.out, "trace-"+t.name+".end"), []byte(line), 0o644)
+}
