diff --git a/cmd/rs2dyn/dump.go b/cmd/rs2dyn/dump.go
new file mode 100644
index 0000000..166d404
--- /dev/null
+++ b/cmd/rs2dyn/dump.go
@@ -0,0 +1,41 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+// untilPC 跑到 CS:IP 的線性位址等於 IDA 位址 ida。用來停在函式入口或迴圈頭。
+func (r *rt) untilPC(ida uint32, budget uint64) error {
+	la, err := r.gaddr(ida)
+	if err != nil {
+		return err
+	}
+	if err := r.runUntil(fmt.Sprintf("PC == %05X", ida), func() bool {
+		c := r.m.CPU
+		return uint32(c.Seg[cpu.CS])<<4+uint32(c.IP) == la
+	}, budget); err != nil {
+		return err
+	}
+	r.logf("untilpc", "%05X reached at step %d", ida, r.m.Steps)
+	return nil
+}
+
+// dumpDS 把整個 64 KB 資料段存成 NAME.ds（dseg:0 起的原始位元組），給重製核心比對初始狀態。
+func (r *rt) dumpDS(name string) error {
+	if _, err := r.gaddr(0x1CBC0); err != nil {
+		return err
+	}
+	b := make([]byte, 0x10000)
+	for i := range b {
+		b[i] = r.m.Read8(r.base + dsBias - idaBase + uint32(i))
+	}
+	if err := os.WriteFile(filepath.Join(r.out, name+".ds"), b, 0o644); err != nil {
+		return err
+	}
+	r.logf("dumpds", "%s", name)
+	return nil
+}
