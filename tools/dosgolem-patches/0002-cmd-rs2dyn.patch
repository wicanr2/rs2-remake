+package main
+
+import (
+	"bufio"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"strconv"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"strings"
+)
+
+// 腳本命令（一行一個，# 之後是註解；數字可用 _ 分隔，0x 開頭是十六進位）：
+//
+//	step N                 跑到絕對步數 N
+//	runsteps N             再跑 N 步
+//	ticks N                再跑 N 個 IRQ0 計時器中斷
+//	untilopen NAME [n [budget]]  跑到累計第 n 次（預設 1）成功開啟這個檔
+//	sheet OUT COLS a b c   把已存的 PNG 拼成一張
+//	untilvec8 [budget]     跑到 INT 8 指到遊戲處理常式（順便定出映像基底）
+//	until16 IDA VAL [budget]   跑到 IDA 位址的 word 等於 VAL
+//	untilframe N [budget]  跑到遊戲幀計數（word_1CFE2）>= N
+//	frames N [budget]      再跑到幀計數增加 N
+//	secs X                 再跑 X 虛擬秒（ticks ÷ PIT 頻率）
+//	hold X / gap X         tap 的預設按住與間隔（虛擬秒，預設 0.15）
+//	tap KEY [hold [gap]]   按下、等 hold 秒、放開、等 gap 秒
+//	chord K1+K2+K3 [hold [gap]]   依序按下、反序放開（Ctrl+Q 之類）
+//	down KEY / up KEY      只按下／只放開（立即排進佇列，不等）
+//	holdkeys K1+K2 SECS    同時按住這些鍵 SECS 秒後放開（方向加開火）
+//	bios KEY               送進 BIOS 緩衝區（只有破解組 intro 讀 int 16h）
+//	shot NAME              存 NAME.png、NAME.json（調色盤、雜湊）
+//	peek NAME IDA LEN      把 IDA 位址起 LEN 位元組寫進日誌
+//	peekw NAME IDA         同上，一個 word
+//	poke IDA HEX           寫位元組
+//	pokew IDA VAL
+//	measure NAME SECS      跑 SECS 虛擬秒，記錄幀、遊戲 tick、翻頁、等待迴圈步數的增量
+//	watchpc IDA            計數執行到這個 IDA 位址的次數（需映像基底）
+//	watchtick              計數 word_273B9 的 +1（遊戲收到的 INT 8 tick）
+//	watchwait              計數 sub_11097 等待迴圈的執行步數
+//	trace NAME / trace off 逐幀記錄遊戲變數到 trace-NAME.tsv
+//	trapint N [max]        記錄進入 INT N 向量所指處理常式時的暫存器
+//	where [NAME]           記錄目前 CS:IP、暫存器與接下來 8 位元組
+//	palwatch on|off       顯示調色盤一變就記一行（含幀計數與具名比對）
+//	set NAME VALUE         之後的行裡 ${NAME} 換成 VALUE
+//	include FILE           執行另一個腳本
+//	log TEXT...            寫一行日誌
+//	expect-exit            要求程式在這個時間點已經結束
+//	expect-running         要求程式還在跑
+func (r *rt) runScript(in io.Reader) error {
+	sc := bufio.NewScanner(in)
+	n := 0
+	for sc.Scan() {
+		n++
+		line := sc.Text()
+		if i := strings.Index(line, "#"); i >= 0 {
+			line = line[:i]
+		}
+		line = os.Expand(line, func(k string) string { return r.vars[k] })
+		f := strings.Fields(line)
+		if len(f) == 0 {
+			continue
+		}
+		if err := r.exec(f); err != nil {
+			return fmt.Errorf("腳本第 %d 行 %q：%w", n, strings.Join(f, " "), err)
+		}
+	}
+	return sc.Err()
+}
+
+func num(s string) (uint64, error) {
+	s = strings.ReplaceAll(s, "_", "")
+	return strconv.ParseUint(s, 0, 64)
+}
+
+func argNum(f []string, i int, def uint64) (uint64, error) {
+	if i >= len(f) {
+		return def, nil
+	}
+	return num(f[i])
+}
+
+func (r *rt) exec(f []string) error {
+	cmd := f[0]
+	need := func(k int) error {
+		if len(f) < k+1 {
+			return fmt.Errorf("%s 需要 %d 個參數", cmd, k)
+		}
+		return nil
+	}
+	switch cmd {
+	case "step":
+		if err := need(1); err != nil {
+			return err
+		}
+		v, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		return r.runTo(v)
+	case "runsteps":
+		if err := need(1); err != nil {
+			return err
+		}
+		v, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		return r.runTo(r.m.Steps + v)
+	case "ticks":
+		if err := need(1); err != nil {
+			return err
+		}
+		v, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		return r.runTicks(v)
+	case "untilvec8":
+		b, err := argNum(f, 1, 1_500_000_000)
+		if err != nil {
+			return err
+		}
+		return r.runUntil("INT 8 指到遊戲", func() bool {
+			_, e := r.gaddr(idaBase)
+			return e == nil
+		}, b)
+	case "until16":
+		if err := need(2); err != nil {
+			return err
+		}
+		a, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		v, err := num(f[2])
+		if err != nil {
+			return err
+		}
+		b, err := argNum(f, 3, 1_500_000_000)
+		if err != nil {
+			return err
+		}
+		return r.runUntil(fmt.Sprintf("word %X == %X", a, v), func() bool {
+			x, e := r.rd16(uint32(a))
+			return e == nil && uint64(x) == v
+		}, b)
+	case "untilframe":
+		if err := need(1); err != nil {
+			return err
+		}
+		v, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		b, err := argNum(f, 2, 1_500_000_000)
+		if err != nil {
+			return err
+		}
+		return r.runUntil(fmt.Sprintf("幀計數 >= %d", v), func() bool {
+			x, e := r.rd16(idaFrame)
+			return e == nil && uint64(x) >= v
+		}, b)
+	case "frames":
+		if err := need(1); err != nil {
+			return err
+		}
+		v, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		b, err := argNum(f, 2, 1_500_000_000)
+		if err != nil {
+			return err
+		}
+		x0, err := r.rd16(idaFrame)
+		if err != nil {
+			return err
+		}
+		return r.runUntil(fmt.Sprintf("幀計數增加 %d", v), func() bool {
+			x, _ := r.rd16(idaFrame)
+			return uint64(x-x0) >= v && x >= x0
+		}, b)
+	case "secs":
+		if err := need(1); err != nil {
+			return err
+		}
+		v, err := argFloat(f, 1, 0)
+		if err != nil {
+			return err
+		}
+		return r.runSecs(v)
+	case "hold":
+		v, err := argFloat(f, 1, 0.15)
+		r.holdSecs = v
+		return err
+	case "gap":
+		v, err := argFloat(f, 1, 0.15)
+		r.gapSecs = v
+		return err
+	case "tap":
+		if err := need(1); err != nil {
+			return err
+		}
+		h, err := argFloat(f, 2, r.holdSecs)
+		if err != nil {
+			return err
+		}
+		g, err := argFloat(f, 3, r.gapSecs)
+		if err != nil {
+			return err
+		}
+		return r.chord([]string{f[1]}, h, g)
+	case "chord":
+		if err := need(1); err != nil {
+			return err
+		}
+		h, err := argFloat(f, 2, r.holdSecs)
+		if err != nil {
+			return err
+		}
+		g, err := argFloat(f, 3, r.gapSecs)
+		if err != nil {
+			return err
+		}
+		return r.chord(strings.Split(f[1], "+"), h, g)
+	case "holdkeys":
+		if err := need(2); err != nil {
+			return err
+		}
+		h, err := argFloat(f, 2, 0)
+		if err != nil {
+			return err
+		}
+		return r.chord(strings.Split(f[1], "+"), h, 0)
+	case "down", "up":
+		if err := need(1); err != nil {
+			return err
+		}
+		s, err := keyScan(f[1])
+		if err != nil {
+			return err
+		}
+		if cmd == "down" {
+			r.down(s)
+		} else {
+			r.up(s)
+		}
+		return nil
+	case "bios":
+		if err := need(1); err != nil {
+			return err
+		}
+		s, err := keyScan(f[1])
+		if err != nil {
+			return err
+		}
+		var ascii uint8
+		if len(f[1]) == 1 {
+			ascii = f[1][0]
+		}
+		switch strings.ToLower(f[1]) {
+		case "enter":
+			ascii = 13
+		case "space":
+			ascii = ' '
+		case "esc":
+			ascii = 27
+		}
+		r.d.PushKey(dosKey(s, ascii))
+		r.logf("key", "bios scan=%02X ascii=%02X", s, ascii)
+		return nil
+	case "shot":
+		if err := need(1); err != nil {
+			return err
+		}
+		return r.shot(f[1])
+	case "sheet":
+		if err := need(3); err != nil {
+			return err
+		}
+		c, err := num(f[2])
+		if err != nil {
+			return err
+		}
+		return r.sheet(f[1], int(c), f[3:])
+	case "untilopen":
+		// untilopen NAME [n [budget]]：跑到累計第 n 次（預設 1）成功開啟這個檔（不分大小寫）
+		if err := need(1); err != nil {
+			return err
+		}
+		nth, err := argNum(f, 2, 0)
+		if err != nil {
+			return err
+		}
+		b, err := argNum(f, 3, 1_500_000_000)
+		if err != nil {
+			return err
+		}
+		want := strings.ToUpper(f[1])
+		target := uint64(1)
+		if nth > 0 {
+			target = nth
+		}
+		return r.runUntil("開檔 "+want, func() bool { return uint64(r.openCount[want]) >= target }, b)
+	case "peek":
+		if err := need(3); err != nil {
+			return err
+		}
+		a, err := num(f[2])
+		if err != nil {
+			return err
+		}
+		l, err := num(f[3])
+		if err != nil {
+			return err
+		}
+		la, err := r.gaddr(uint32(a))
+		if err != nil {
+			return err
+		}
+		b := make([]byte, l)
+		for i := range b {
+			b[i] = r.m.Read8(la + uint32(i))
+		}
+		r.logf("peek", "%s ida=%X lin=%05X %s", f[1], a, la, hex.EncodeToString(b))
+		return nil
+	case "peekw":
+		if err := need(2); err != nil {
+			return err
+		}
+		a, err := num(f[2])
+		if err != nil {
+			return err
+		}
+		v, err := r.rd16(uint32(a))
+		if err != nil {
+			return err
+		}
+		r.logf("peek", "%s ida=%X word=%04X (%d)", f[1], a, v, v)
+		return nil
+	case "poke":
+		if err := need(2); err != nil {
+			return err
+		}
+		a, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		b, err := hex.DecodeString(f[2])
+		if err != nil {
+			return err
+		}
+		la, err := r.gaddr(uint32(a))
+		if err != nil {
+			return err
+		}
+		for i, v := range b {
+			r.m.Write8(la+uint32(i), v)
+		}
+		r.logf("poke", "ida=%X lin=%05X %s", a, la, f[2])
+		return nil
+	case "pokew":
+		if err := need(2); err != nil {
+			return err
+		}
+		a, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		v, err := num(f[2])
+		if err != nil {
+			return err
+		}
+		la, err := r.gaddr(uint32(a))
+		if err != nil {
+			return err
+		}
+		r.m.Write16(la, uint16(v))
+		r.logf("poke", "ida=%X lin=%05X word=%04X", a, la, v)
+		return nil
+	case "watchtick":
+		return r.watchTick()
+	case "watchwait":
+		return r.watchWait()
+	case "watchpc":
+		if err := need(1); err != nil {
+			return err
+		}
+		a, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		la, err := r.gaddr(uint32(a))
+		if err != nil {
+			return err
+		}
+		r.watchLin = append(r.watchLin, la)
+		r.logf("watchpc", "ida=%X lin=%05X", a, la)
+		return nil
+	case "measure":
+		if err := need(2); err != nil {
+			return err
+		}
+		t, err := argFloat(f, 2, 0)
+		if err != nil {
+			return err
+		}
+		return r.measure(f[1], t)
+	case "trace":
+		// trace NAME 開始逐幀記錄到 trace-NAME.tsv；trace off 結束
+		if err := need(1); err != nil {
+			return err
+		}
+		if f[1] == "off" {
+			r.traceStop()
+			return nil
+		}
+		return r.traceStart(f[1])
+	case "trapint":
+		// trapint N [max]：記錄每次進入 INT N 向量所指處理常式時的暫存器
+		if err := need(1); err != nil {
+			return err
+		}
+		n, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		mx, err := argNum(f, 2, 50)
+		if err != nil {
+			return err
+		}
+		return r.addTrapInt(int(n), int(mx))
+	case "portmark":
+		// portmark NAME：記錄埠 42h／43h／61h／388h 的累計寫入數（相鄰兩個 mark 相減即區間內的寫入數）
+		n := "mark"
+		if len(f) > 1 {
+			n = f[1]
+		}
+		r.drainPorts()
+		r.logf("portmark", "%s port42=%d port43=%d port61=%d port388=%d", n, r.portCount[0x42], r.portCount[0x43], r.portCount[0x61], r.portCount[0x388])
+		return nil
+	case "untilwrote":
+		// untilwrote N [budget]：跑到遊戲累計寫檔次數 >= N（PIC.DA1～DA4 各算一次）
+		if err := need(1); err != nil {
+			return err
+		}
+		n, err := num(f[1])
+		if err != nil {
+			return err
+		}
+		b, err := argNum(f, 2, 300_000_000)
+		if err != nil {
+			return err
+		}
+		return r.runUntil("寫檔次數", func() bool { return uint64(len(r.d.Wrote)) >= n }, b)
+	case "dumpplanes":
+		if err := need(1); err != nil {
+			return err
+		}
+		return r.dumpPlanes(f[1])
+	case "wrote":
+		// wrote [NAME]：記錄遊戲寫檔（暫存層）的累計次數與檔名
+		n := "now"
+		if len(f) > 1 {
+			n = f[1]
+		}
+		var names []string
+		for _, w := range r.d.Wrote {
+			names = append(names, fmt.Sprintf("%s(%d)", w.Name, w.N))
+		}
+		r.logf("wrote", "%s count=%d %s", n, len(r.d.Wrote), strings.Join(names, ","))
+		return nil
+	case "where":
+		n := "here"
+		if len(f) > 1 {
+			n = f[1]
+		}
+		r.where(n)
+		return nil
+	case "palwatch":
+		if err := need(1); err != nil {
+			return err
+		}
+		r.palWatch = f[1] == "on"
+		r.palShots = len(f) > 2 && f[2] == "shots"
+		r.palShotN = 0
+		r.palKey = ""
+		return nil
+	case "set":
+		// set NAME VALUE：之後的行裡 ${NAME} 換成 VALUE
+		if err := need(2); err != nil {
+			return err
+		}
+		if r.vars == nil {
+			r.vars = map[string]string{}
+		}
+		r.vars[f[1]] = f[2]
+		return nil
+	case "include":
+		if err := need(1); err != nil {
+			return err
+		}
+		fh, err := os.Open(f[1])
+		if err != nil {
+			return err
+		}
+		defer fh.Close()
+		return r.runScript(fh)
+	case "log":
+		r.logf("note", "%s", strings.Join(f[1:], " "))
+		return nil
+	case "expect-exit":
+		if !r.d.Exited {
+			return fmt.Errorf("預期程式已結束，但還在跑")
+		}
+		r.logf("exit", "code=%d", r.d.ExitCode)
+		return nil
+	case "expect-running":
+		if r.d.Exited {
+			return fmt.Errorf("預期程式還在跑，但已結束（exit=%d）", r.d.ExitCode)
+		}
+		return nil
+	}
+	return fmt.Errorf("不認得的命令 %q", cmd)
+}
+
+// measure 跑 ticks 個 IRQ0，記下各計數的增量。幀計數與遊戲 tick 計數需要映像基底。
+func (r *rt) measure(name string, secs float64) error {
+	m := r.m
+	s0, t0, fl0, sec0, gt0, w0 := m.Steps, m.Ticks, r.flips, r.simSec, r.gameTicks, r.waitSteps()
+	r.drainPorts()
+	pc0 := map[uint16]uint64{}
+	for k, v := range r.portCount {
+		pc0[k] = v
+	}
+	fr0, errF := r.rd16(idaFrame)
+	h0 := map[uint32]uint64{}
+	for k, v := range r.handlerEntries {
+		h0[k] = v
+	}
+	// 幀計數遞增的步數間隔：逐步觀察
+	var last uint16 = fr0
+	var lastStep = m.Steps
+	var intervals []uint64
+	var framesSeen uint64
+	end := r.simSec + secs
+	for r.simSec < end && !r.d.Exited {
+		if err := r.step(); err != nil {
+			return err
+		}
+		if errF == nil {
+			x := m.Read16(r.base + idaFrame - idaBase)
+			if x != last {
+				if x == last+1 {
+					intervals = append(intervals, m.Steps-lastStep)
+				}
+				framesSeen += uint64(x - last)
+				last, lastStep = x, m.Steps
+			}
+		}
+		if err := r.over(); err != nil {
+			return err
+		}
+	}
+	dSteps, dTicks, dFlips, dSec, dGT := m.Steps-s0, m.Ticks-t0, r.flips-fl0, r.simSec-sec0, r.gameTicks-gt0
+	dWait := r.waitSteps() - w0
+	var sum uint64
+	for _, v := range intervals {
+		sum += v
+	}
+	var meanInt float64
+	if len(intervals) > 0 {
+		meanInt = float64(sum) / float64(len(intervals))
+	}
+	r.logf("measure", "%s steps=%d irq0=%d sim_seconds=%.4f pit_div_end=%d pit_hz_end=%.4f irq0_every_end=%d steps_per_s_now=%.0f",
+		name, dSteps, dTicks, dSec, m.PITDivisor(), m.PITHz(), m.IRQ0Every, m.StepsPerSecondNow())
+	if dSec > 0 {
+		r.logf("measure", "%s irq0_hz=%.4f game_ticks=%d game_tick_hz=%.4f", name, float64(dTicks)/dSec, dGT, float64(dGT)/dSec)
+		if framesSeen > 0 {
+			r.logf("measure", "%s frame_counter_delta=%d fps_frame_counter=%.4f game_ticks_per_frame=%.4f mean_steps_per_frame=%.1f", name,
+				framesSeen, float64(framesSeen)/dSec, float64(dGT)/float64(framesSeen), meanInt)
+			if dWait > 0 || len(r.waitLin) > 0 {
+				r.logf("measure", "%s wait_loop_steps=%d busy_steps=%d busy_steps_per_frame=%.0f wait_fraction=%.4f", name,
+					dWait, dSteps-dWait, float64(dSteps-dWait)/float64(framesSeen), float64(dWait)/float64(dSteps))
+			}
+		}
+		r.drainPorts()
+		r.logf("measure", "%s page_flips=%d fps_page_flips=%.4f port42_writes=%d port388_writes=%d", name, dFlips, float64(dFlips)/dSec, r.portCount[0x42]-pc0[0x42], r.portCount[0x388]-pc0[0x388])
+		for k, v := range r.handlerEntries {
+			dh := v - h0[k]
+			r.logf("measure", "%s pc_hits lin=%05X count=%d", name, k, dh)
+		}
+	}
+	return nil
+}
+
+func argFloat(f []string, i int, def float64) (float64, error) {
+	if i >= len(f) {
+		return def, nil
+	}
+	return strconv.ParseFloat(strings.ReplaceAll(f[i], "_", ""), 64)
+}
+
+func (r *rt) where(name string) {
+	c := r.m.CPU
+	lin := uint32(c.Seg[cpu.CS])<<4 + uint32(c.IP)
+	b := make([]byte, 8)
+	for i := range b {
+		b[i] = r.m.Read8(lin + uint32(i))
+	}
+	ida := ""
+	if r.base != 0 && lin >= r.base && lin-r.base < 0x20000 {
+		ida = fmt.Sprintf(" ida=%05X", lin-r.base+idaBase)
+	}
+	r.logf("where", "%s %04X:%04X lin=%05X%s bytes=%s IF=%v SS:SP=%04X:%04X AX=%04X BX=%04X CX=%04X DX=%04X DS=%04X", name,
+		c.Seg[cpu.CS], c.IP, lin, ida, hex.EncodeToString(b), c.Flag(cpu.IF), c.Seg[cpu.SS], c.R[cpu.SP],
+		c.R[cpu.AX], c.R[cpu.BX], c.R[cpu.CX], c.R[cpu.DX], c.Seg[cpu.DS])
+}
